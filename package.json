{
	"name": "@elsikora/prlint",
	"version": "1.0.2",
	"description": "Standalone pull request linting, generation and create-or-update CLI",
	"keywords": [
		"pull-request",
		"pr",
		"lint",
		"github",
		"automation",
		"conventional",
		"quality"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ElsiKora/PRLint"
	},
	"license": "MIT",
	"author": "ElsiKora",
	"type": "module",
	"exports": {
		".": {
			"types": "./bin/index.d.ts"
		}
	},
	"main": "bin/index.js",
	"types": "./bin/index.d.ts",
	"bin": {
		"prlint": "./bin/cli.js"
	},
	"files": [
		"bin"
	],
	"scripts": {
		"branch": "npx @elsikora/git-branch-lint -b",
		"prebuild": "rimraf bin",
		"build": "npm run prebuild && rollup -c",
		"build:test": "npm run prebuild && rollup -c rollup.test.config.js",
		"commit": "cz",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint ./",
		"lint:all": "npm run lint && npm run lint:types",
		"lint:all:fix": "npm run lint:fix && npm run lint:types:fix",
		"lint:fix": "eslint --fix ./",
		"lint:types": "tsc --noEmit",
		"lint:types:fix": "tsc --noEmit --skipLibCheck",
		"prepare": "husky",
		"release": "semantic-release",
		"test:all": "npm run test:unit && npm run test:e2e",
		"test:e2e": "npm run build:test && vitest --config vitest.e2e.config.js --typecheck.tsconfig tsconfig.json",
		"test:unit": "vitest run test/unit --config vitest.unit.config.js"
	},
	"config": {
		"commitizen": {
			"path": "@elsikora/commitizen-plugin-commitlint-ai"
		}
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.75.0",
		"@commitlint/ensure": "^20.4.1",
		"@commitlint/lint": "^20.4.1",
		"@commitlint/load": "^20.4.0",
		"@commitlint/types": "^20.4.0",
		"@elsikora/cladi": "^2.0.2",
		"@google/generative-ai": "^0.24.1",
		"@rollup/plugin-typescript": "^12.3.0",
		"chalk": "^5.6.2",
		"cosmiconfig": "^9.0.0",
		"dotenv": "^17.3.1",
		"javascript-stringify": "^2.1.0",
		"lodash.isplainobject": "^4.0.6",
		"openai": "^6.22.0",
		"ora": "^9.3.0",
		"path-to-regexp": "^8.3.0",
		"prompts": "^2.4.2",
		"rollup": "^4.57.1",
		"rollup-plugin-dts-path-alias": "^0.0.3",
		"rollup-plugin-generate-package-json": "^3.2.0",
		"word-wrap": "^1.2.5",
		"yaml": "^2.8.2",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@commitlint/cz-commitlint": "^20.4.1",
		"@elsikora/commitizen-plugin-commitlint-ai": "^2.4.0",
		"@elsikora/eslint-config": "^3.10.0",
		"@elsikora/git-branch-lint": "^1.2.2",
		"@saithodev/semantic-release-backmerge": "^4.0.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.4",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@types/lodash.isfunction": "^3.0.9",
		"@types/lodash.isplainobject": "^4.0.9",
		"@types/node": "^25.2.3",
		"@types/prompts": "^2.4.9",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "^4.0.18",
		"commitizen": "^4.3.1",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"eslint": "^10.0.0",
		"eslint-plugin-n": "^18.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"lodash.isfunction": "^3.0.9",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.3",
		"semantic-release": "^25.0.3",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18"
	},
	"publishConfig": {
		"access": "public"
	}
}
